# Token do bot, obtido com o @BotFather (obrigatório)
BOT_TOKEN=coloque_o_token_do_BotFather_aqui

# Teto de mensagens por /pow. A quantidade real vem do roteiro do fogo sorteado
# (src/data/onomatopeias.ts); o maior roteiro (bateria) chega a 8.
POW_MAX_MESSAGES=8

# Tempo em que o /pow fica bloqueado em um grupo depois que o fogo termina (0 desativa)
POW_COOLDOWN_SECONDS=5

# Logs: nível (trace, debug, info, warn, error, fatal), pasta, tamanho máximo por arquivo
# (k/m/g) e quantos arquivos antigos manter além do atual.
# Sem LOG_LEVEL, o padrão é "info" em desenvolvimento e "warn" em produção (só avisos e erros).
# Descomente para investigar algo, ex.: LOG_LEVEL=info ou LOG_LEVEL=debug
# LOG_LEVEL=info
LOG_DIR=logs
LOG_MAX_SIZE=1m
LOG_MAX_FILES=5
