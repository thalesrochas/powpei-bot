# Token do bot, obtido com o @BotFather (obrigatório)
BOT_TOKEN=coloque_o_token_do_BotFather_aqui

# Quantidade de mensagens por /pow (sorteada entre min e max)
POW_MIN_MESSAGES=1
POW_MAX_MESSAGES=5

# Pausa aleatória entre as mensagens, em milissegundos
POW_DELAY_MIN_MS=300
POW_DELAY_MAX_MS=1200

# Tempo em que o /pow fica bloqueado em um grupo após ser usado (0 desativa)
POW_COOLDOWN_SECONDS=10

# Logs: nível (trace, debug, info, warn, error, fatal), pasta, tamanho máximo por arquivo
# (k/m/g) e quantos arquivos antigos manter além do atual
LOG_LEVEL=info
LOG_DIR=logs
LOG_MAX_SIZE=1m
LOG_MAX_FILES=5
